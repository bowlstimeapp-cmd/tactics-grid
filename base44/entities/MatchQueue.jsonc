{
  "name": "MatchQueue",
  "type": "object",
  "properties": {
    "player_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "elo": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "searching",
        "matched",
        "cancelled",
        "declined"
      ]
    },
    "match_id": {
      "type": "string",
      "default": ""
    },
    "game_mode": {
      "type": "string",
      "enum": [
        "standard",
        "enlarged"
      ],
      "default": "standard"
    },
    "challenged_id": {
      "type": "string",
      "default": ""
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    }
  },
  "required": [
    "player_id",
    "player_name",
    "elo"
  ]
}